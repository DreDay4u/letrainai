---
const navLinks = [
  { href: "/", label: "Home" },
  { href: "/services", label: "Services" },
  { href: "/about", label: "About" },
  { href: "/case-studies", label: "Case Studies" },
  { href: "/assessment", label: "Assessment" },
  { href: "/blog", label: "Blog" },
  { href: "/faq", label: "FAQ" },
];
---

<header class="sticky top-0 z-50 border-b border-hairline bg-canvas/95 backdrop-blur-sm">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
    <a href="/" class="text-xl font-medium text-ink" style="font-family: var(--font-serif);">LeTrainAI</a>

    <div class="hidden items-center gap-8 md:flex">
      {navLinks.map((link) => (
        <a href={link.href} class="text-sm text-body transition-colors hover:text-ink">{link.label}</a>
      ))}
      <a href="/assessment" class="inline-flex h-9 items-center justify-center gap-2 whitespace-nowrap rounded-lg bg-accent px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-accent-hover">
        Start my assessment
      </a>
    </div>

    <details class="md:hidden relative">
      <summary class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-md text-body [&::-webkit-details-marker]:hidden" aria-label="Toggle menu">
        <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round"/></svg>
      </summary>
      <div class="absolute right-0 top-full mt-2 w-56 rounded-md border border-hairline bg-canvas py-2 shadow-lg">
        {navLinks.map((link) => (
          <a href={link.href} class="block px-4 py-2 text-sm text-body hover:bg-surface hover:text-ink">{link.label}</a>
        ))}
        <a href="/assessment" class="mt-2 block border-t border-hairline px-4 py-3 text-sm font-medium text-accent">Start my assessment</a>
      </div>
    </details>
  </nav>
</header>
