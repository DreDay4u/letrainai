---
/**
 * Shared renderer for the full paid report body — used by the paid
 * /report/[session_id] delivery page and the /sample-report demo page.
 * Renders everything below the page header: executive summary, ranked
 * opportunities, 90-day roadmap, tool stack, ROI projection, next steps,
 * disclaimer.
 */
interface Props {
  result: Record<string, any>;
}

const { result } = Astro.props;

const DIFFICULTY_STYLES: Record<string, string> = {
  low: 'bg-emerald-100 text-emerald-800',
  medium: 'bg-amber-100 text-amber-800',
  high: 'bg-red-100 text-red-800',
};
---

{result.report?.summary && (
  <section class="mb-10">
    <h2 class="font-mono text-xs uppercase tracking-[0.2em] text-muted mb-4">Executive summary</h2>
    <p class="text-body leading-relaxed">{result.report.summary}</p>
  </section>
)}

<section class="mb-10">
  <h2 class="font-serif text-2xl sm:text-3xl text-ink mb-6">Your automation opportunities, ranked</h2>
  <ol class="space-y-4">
    {result.recommendations?.map((rec: any, i: number) => (
      <li class="rounded-lg border border-hairline bg-surface p-6">
        <div class="flex items-start justify-between gap-4 mb-2">
          <p class="font-serif text-lg text-ink">
            <span class="font-mono text-muted mr-2">{i + 1}.</span>{rec.title}
          </p>
          <span class={`shrink-0 rounded-full px-3 py-1 font-mono text-xs uppercase tracking-wider ${DIFFICULTY_STYLES[rec.difficulty] ?? ''}`}>{rec.difficulty}</span>
        </div>
        <p class="text-sm text-body leading-relaxed mb-3">{rec.description}</p>
        <p class="font-mono text-xs text-muted">Saves {rec.estimated_time_saved}</p>
      </li>
    ))}
  </ol>
</section>

{result.report?.roadmap && (
  <section class="mb-10">
    <h2 class="font-serif text-2xl sm:text-3xl text-ink mb-6">Your 90-day implementation roadmap</h2>
    <div class="space-y-4">
      {result.report.roadmap.map((phase: any) => (
        <div class="rounded-lg border border-hairline bg-surface p-6">
          <div class="flex items-baseline justify-between gap-4 mb-3">
            <p class="font-serif text-lg text-ink">{phase.focus}</p>
            <p class="font-mono text-xs text-accent shrink-0">{phase.phase}</p>
          </div>
          <ul class="space-y-2">
            {phase.actions.map((action: string) => (
              <li class="flex items-start gap-2.5 text-sm text-body">
                <span class="font-mono text-accent text-sm shrink-0">→</span>
                <span>{action}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
)}

{result.report?.tool_stack && (
  <section class="mb-10">
    <h2 class="font-serif text-2xl sm:text-3xl text-ink mb-6">Recommended tool stack</h2>
    <div class="rounded-lg border border-hairline bg-surface overflow-hidden">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-hairline">
            <th class="text-left font-mono text-xs uppercase tracking-wider text-muted px-4 py-3">Category</th>
            <th class="text-left font-mono text-xs uppercase tracking-wider text-muted px-4 py-3">Recommendation</th>
            <th class="text-right font-mono text-xs uppercase tracking-wider text-muted px-4 py-3">Est. cost</th>
          </tr>
        </thead>
        <tbody>
          {result.report.tool_stack.map((tool: any) => (
            <tr class="border-b border-hairline last:border-b-0">
              <td class="px-4 py-3 text-ink">{tool.category}</td>
              <td class="px-4 py-3 text-body">{tool.recommendation}</td>
              <td class="px-4 py-3 text-right font-mono text-xs text-muted whitespace-nowrap">{tool.est_monthly_cost}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
)}

{result.report?.roi && (
  <section class="mb-10">
    <h2 class="font-serif text-2xl sm:text-3xl text-ink mb-6">ROI projection</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="rounded-lg border border-hairline bg-surface p-6">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-muted mb-2">One-time setup</p>
        <p class="font-serif text-2xl text-ink">{result.report.roi.setup_cost}</p>
      </div>
      <div class="rounded-lg border border-hairline bg-surface p-6">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-muted mb-2">Monthly savings</p>
        <p class="font-serif text-2xl text-ink">{result.report.roi.monthly_savings}</p>
      </div>
      <div class="rounded-lg border border-hairline bg-surface p-6">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-muted mb-2">Break-even</p>
        <p class="font-serif text-2xl text-ink">{result.report.roi.break_even}</p>
      </div>
      <div class="rounded-lg border border-accent bg-surface p-6">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-muted mb-2">First-year net</p>
        <p class="font-serif text-2xl text-accent">{result.report.roi.first_year_net}</p>
      </div>
    </div>
  </section>
)}

{result.next_steps && (
  <section class="mb-10">
    <div class="rounded-lg border border-hairline bg-surface p-6">
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-muted mb-2">Recommended next step</p>
      <p class="text-body leading-relaxed">{result.next_steps}</p>
    </div>
  </section>
)}

<p class="text-xs text-muted leading-relaxed">{result.disclaimer}</p>
