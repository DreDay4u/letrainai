---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import { getAllCaseStudies } from '../lib/content';

const studies = await getAllCaseStudies();
---

<BaseLayout
  title="Case Studies — LeTrainAI"
  description="Real-world examples of AI automation solving concrete business problems — measurable results, practical implementations."
>
  <main>
    <Section maxWidth="narrow">
      <h1 class="font-serif font-normal text-3xl tracking-tight text-ink sm:text-4xl">
        What AI looks like when it works.
      </h1>
      <p class="mt-4 max-w-xl text-lg text-body">
        Concrete examples of AI automation solving real business problems.
        These are illustrative scenarios based on common SMB patterns.
      </p>

      <div class="mt-12 grid gap-6 sm:grid-cols-2">
        {studies.map((study) => (
          <a
            href={`/case-studies/${study.slug}`}
            class="group block rounded-lg border border-hairline bg-surface p-6 transition-colors hover:border-accent"
          >
            <span class="font-mono text-xs text-muted">
              {study.industry} · {study.companySize}
            </span>
            <h2 class="mt-2 font-serif text-xl text-ink transition-colors group-hover:text-accent">
              {study.title}
            </h2>
            <p class="mt-2 text-sm text-body">{study.challenge}</p>
            <p class="mt-3 text-sm font-medium text-accent">
              {study.result}
            </p>
          </a>
        ))}
      </div>
    </Section>
  </main>
</BaseLayout>
