---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="LeTrainAI — AI Consulting That Ships">
  <section class="flex flex-col items-center justify-center px-6 py-32 text-center">
    <h1 class="max-w-3xl text-4xl font-bold tracking-tight sm:text-6xl">
      AI Consulting That Ships
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-white/70">
      Practical AI strategy, automation, and implementation for businesses that want
      real outcomes — not demos. Assessment to deployment, end to end.
    </p>
    <div class="mt-10 flex gap-4">
      <a href="/assessment" class="rounded-lg bg-blue-600 px-6 py-3 font-medium hover:bg-blue-500">Take the Assessment</a>
      <a href="/contact" class="rounded-lg border border-white/20 px-6 py-3 font-medium hover:bg-white/10">Get in Touch</a>
    </div>
  </section>
</BaseLayout>
