---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import WorkflowStory from '../components/WorkflowStory.astro';
import { getCollection } from 'astro:content';

const problems = [
  "Manual data entry that AI completes in seconds",
  "Customer questions answered by a bot that never sleeps",
  "Reports generated automatically — no more late nights in Excel",
];

const services = [
  { num: "01", title: "AI Automation", desc: "Eliminate repetitive tasks eating your team's day." },
  { num: "02", title: "AI-Enhanced Websites", desc: "Sites that capture leads, answer questions, book appointments." },
  { num: "03", title: "AI Consulting", desc: "Strategy without the enterprise price tag." },
  { num: "04", title: "Workflow Automation", desc: "Connect your tools so data flows automatically." },
];

// Alphabetical by id — matches the legacy loader's readdirSync order (same as /case-studies).
const studies = (await getCollection('caseStudies')).sort((a, b) =>
  a.id.localeCompare(b.id),
);
const featuredStudies = studies.slice(0, 2);
---

<BaseLayout title="LeTrainAI — AI Consulting for Business">
  <main class="overflow-x-clip">
    {/* ── Hero — restrained premium, text LCP, no image blocker ── */}
    <section class="relative">
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        {/* warm paper wash + faint gold seam — texture, not decoration */}
        <div class="absolute inset-0 bg-[radial-gradient(120%_90%_at_18%_0%,oklch(0.955_0.016_85/0.9)_0%,transparent_55%)]"></div>
        <div class="absolute inset-y-0 right-0 w-px bg-gradient-to-b from-transparent via-gold-500/25 to-transparent"></div>
      </div>
      <div class="relative mx-auto flex min-h-[86svh] w-full max-w-6xl flex-col justify-center px-6 py-20 sm:py-24">
        <div class="max-w-3xl">
          <h1 class="text-hero font-serif font-normal tracking-tight text-ink">
            Stop losing $47,000/year to tasks your competitors already
            automated.
          </h1>
          <p class="mt-7 max-w-xl text-lg leading-relaxed text-body">
            LeTrainAI builds custom AI systems that handle your repetitive work —
            so your team focuses on growth, not busywork.
          </p>
          <div class="mt-9 flex flex-col gap-4 sm:flex-row sm:items-center">
            <a
              href="/assessment"
              class="inline-flex items-center justify-center rounded-md bg-accent px-6 py-3 text-sm font-medium text-canvas shadow-card transition-all duration-base hover:bg-accent-hover hover:shadow-lift active:translate-y-px"
            >
              Start my free AI assessment
            </a>
            <a
              href="/process"
              class="inline-flex items-center gap-1.5 text-sm font-medium text-accent transition-colors duration-base hover:text-accent-hover"
            >
              See how it works
              <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    {/* ── Pain / trust setup ── */}
    <Section class="bg-surface" maxWidth="narrow">
      <h2 class="font-serif font-normal text-2xl tracking-tight text-ink sm:text-3xl">
        Most businesses waste 15+ hours every week on work AI should be doing.
      </h2>
      <ul class="mt-10 space-y-6">
        {problems.map((p) => (
          <li class="border-l-2 border-accent pl-4 text-lg text-body">{p}</li>
        ))}
      </ul>
    </Section>

    {/* ── THE cinematic section — manual → connected → coordinated ── */}
    <WorkflowStory />

    {/* ── Services ── */}
    <Section maxWidth="narrow">
      <h2 class="font-serif font-normal text-2xl tracking-tight text-ink sm:text-3xl">
        We build the AI systems that do that work for you.
      </h2>
      <div class="mt-10 border-t border-hairline">
        {services.map((s) => (
          <a href="/services" class="group flex gap-4 border-b border-l-2 border-transparent border-t-transparent py-6 pl-4 transition-colors duration-base hover:border-l-accent sm:gap-6">
            <span class="font-mono text-sm text-muted">{s.num}</span>
            <div>
              <h3 class="font-serif text-xl text-ink transition-colors duration-base group-hover:text-accent">{s.title}</h3>
              <p class="mt-1.5 text-body">{s.desc}</p>
            </div>
          </a>
        ))}
      </div>
    </Section>

    {/* ── Proof — case studies ── */}
    <Section class="bg-surface">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        <h2 class="max-w-lg font-serif font-normal text-2xl tracking-tight text-ink sm:text-3xl">
          What AI looks like when it works.
        </h2>
        <a
          href="/case-studies"
          class="inline-flex shrink-0 items-center gap-1.5 text-sm font-medium text-accent transition-colors duration-base hover:text-accent-hover"
        >
          All case studies
          <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
      <div class="mt-10 grid gap-6 sm:grid-cols-2">
        {featuredStudies.map((study) => (
          <a
            href={`/case-studies/${study.id}`}
            class="group block rounded-lg border border-hairline bg-canvas p-6 shadow-card transition-all duration-base hover:-translate-y-0.5 hover:border-accent hover:shadow-lift"
          >
            <span class="font-mono text-xs text-muted">
              {study.data.industry} · {study.data.companySize}
            </span>
            <h3 class="mt-2 font-serif text-xl text-ink transition-colors duration-base group-hover:text-accent">
              {study.data.title}
            </h3>
            <p class="mt-2 text-sm text-body">{study.data.challenge}</p>
            <p class="mt-3 text-sm font-medium text-accent">{study.data.result}</p>
            {study.data.isIllustrative && (
              <p class="mt-4 font-mono text-xs text-muted">Illustrative scenario</p>
            )}
          </a>
        ))}
      </div>
    </Section>

    {/* ── Assessment CTA ── */}
    <Section>
      <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        <h2 class="max-w-lg font-serif font-normal text-2xl tracking-tight text-ink sm:text-3xl">
          See your AI opportunity in 3 minutes.
        </h2>
        <a
          href="/assessment"
          class="inline-flex shrink-0 items-center gap-1.5 text-base font-medium text-accent transition-colors duration-base hover:text-accent-hover"
        >
          Start my free assessment
          <svg class="size-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </Section>

    {/* ── Authority — genuine scarcity, dark act ── */}
    <section class="color-scheme-dark bg-dark-surface px-6 py-16 sm:py-24">
      <div class="mx-auto w-full max-w-3xl">
        <h2 class="font-serif font-normal text-2xl tracking-tight text-paper-on-dark sm:text-3xl">
          Be among our first 10 clients.
        </h2>
        <p class="mt-4 max-w-xl text-lg leading-relaxed text-mist-on-dark">
          Finding clients receive priority implementation and founding-partner
          pricing.
        </p>
      </div>
    </section>

    {/* ── Conversion CTA ── */}
    <Section class="bg-surface">
      <div class="text-center">
        <h2 class="mx-auto max-w-xl font-serif font-normal text-2xl tracking-tight text-ink sm:text-3xl">
          Your competitors already automated. Start here.
        </h2>
        <div class="mt-8 flex justify-center">
          <a
            href="/assessment"
            class="inline-flex items-center justify-center rounded-md bg-accent px-6 py-3 text-sm font-medium text-canvas shadow-card transition-all duration-base hover:bg-accent-hover hover:shadow-lift active:translate-y-px"
          >
            Start my free AI assessment
          </a>
        </div>
      </div>
    </Section>
  </main>
</BaseLayout>
