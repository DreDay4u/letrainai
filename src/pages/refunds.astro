---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Refund Policy — LeTrainAI"
  description="LeTrainAI refund policy for the AI Readiness Report and strategy sessions. 14-day refund guarantee on reports."
>
  <main class="bg-canvas text-body">
    <div class="px-6 py-16 sm:py-24 pt-32 pb-24">
      <div class="mx-auto w-full max-w-2xl">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-muted mb-6">Policy</p>
        <h1 class="font-serif text-4xl sm:text-5xl text-ink leading-[1.05] mb-10">Refund Policy</h1>

        <div class="space-y-8 text-body leading-relaxed">
          <section>
            <h2 class="font-serif text-2xl text-ink mb-3">AI Readiness Report — 14-day guarantee</h2>
            <p>
              If your Full AI Readiness Report doesn't deliver meaningful insight into your
              automation opportunities, email
              <a href="mailto:hello@letrainai.com" class="text-accent underline underline-offset-4">hello@letrainai.com</a>
              within 14 days of purchase and we'll refund you in full — no questions asked.
              Include the email you paid with (or your report link) so we can locate the order.
            </p>
          </section>

          <section>
            <h2 class="font-serif text-2xl text-ink mb-3">Strategy sessions</h2>
            <p>
              The Report + Strategy Session bundle is refundable up to 24 hours before the
              scheduled session. After the session has taken place, the bundle is no longer
              refundable, though the report itself remains covered by the 14-day guarantee.
              Sessions can be rescheduled free of charge with 24 hours' notice.
            </p>
          </section>

          <section>
            <h2 class="font-serif text-2xl text-ink mb-3">Processing</h2>
            <p>
              Approved refunds are issued to your original payment method, typically within
              5–10 business days. Payments are processed by Stripe; LeTrainAI never stores
              your card details.
            </p>
          </section>

          <section>
            <h2 class="font-serif text-2xl text-ink mb-3">Free assessment</h2>
            <p>
              The 3-minute assessment and its summary results are free and always available at
              <a href="/assessment" class="text-accent underline underline-offset-4">letrainai.com/assessment</a>.
            </p>
          </section>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
