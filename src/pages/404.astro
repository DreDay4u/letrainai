---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';

/**
 * Custom 404 — keeps stranded visitors inside the funnel instead of
 * bouncing to a bare server error page.
 */
---

<BaseLayout
  title="Page Not Found — LeTrainAI"
  description="This page doesn't exist. Start the free AI assessment or see our pricing."
>
  <main class="bg-canvas text-body">
    <div class="px-6 py-24 sm:py-32 pt-32">
      <div class="mx-auto w-full max-w-2xl text-center">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-muted mb-4">404</p>
        <h1 class="font-serif text-3xl sm:text-4xl text-ink mb-4">That page moved on without us</h1>
        <p class="text-muted mb-10">
          The link is broken or the page never existed — but your next automation
          opportunity is still 3 minutes away.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="/assessment" class="inline-flex items-center gap-2 rounded-lg bg-accent px-6 py-3 font-sans text-sm font-medium text-white transition-colors hover:bg-accent-hover">
            Take the free AI assessment →
          </a>
          <a href="/pricing" class="inline-flex items-center gap-2 rounded-lg border border-accent px-6 py-3 font-sans text-sm font-medium text-accent transition-colors hover:bg-canvas">
            See pricing
          </a>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
