---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReportBody from '../../components/ReportBody.astro';
import { supabase, isSupabaseConfigured } from '../../lib/supabase';
import { maskFreeResult } from '../../lib/assessment/report';
import { getSizeBenchmark, benchmarkVerdict, type CompanySize } from '../../lib/assessment/benchmark';

/**
 * Full AI Readiness Report — /report/[session_id]
 *
 * Server-rendered delivery surface for the paid report. The full generated
 * result lives server-side in Supabase; it renders ONLY when the row's
 * payment_status is 'paid'. Unpaid completed assessments get their FREE
 * teaser (via maskFreeResult — the same projection the wizard receives)
 * plus resume-checkout forms (plain form POST to /api/checkout) so an
 * abandoned checkout can be finished without retaking the assessment.
 * This makes the report URL a returnable artifact for free users too.
 */

const sessionId = Astro.params.session_id ?? '';

let row: Record<string, any> | null = null;
if (isSupabaseConfigured && /^[A-Za-z0-9-]{8,64}$/.test(sessionId)) {
  const { data, error } = await supabase
    .from('assessment_results')
    .select('session_id, status, payment_status, paid_tier, email, recommendation, paid_at, responses')
    .eq('session_id', sessionId)
    .maybeSingle();
  if (error) console.error('[report] Supabase lookup failed:', error);
  row = data ?? null;
}

const found = Boolean(row && row.status === 'completed');
const paid = found && row!.payment_status === 'paid';
const result = paid ? (row!.recommendation ?? null) : null;
const isSessionTier = paid && row!.paid_tier === 'session';
const freeTeaser =
  found && !paid && row!.recommendation ? maskFreeResult(row!.recommendation) : null;

const rawSize: unknown = row?.responses?.company_size;
const bench =
  typeof rawSize === 'string' && rawSize !== ''
    ? { size: rawSize as CompanySize, ...getSizeBenchmark(rawSize as CompanySize) }
    : null;
const verdict = bench ? benchmarkVerdict((paid ? result : freeTeaser)?.opportunity_score ?? 0, bench.typicalScore) : null;
const VERDICT_COPY: Record<string, string> = {
  above: " — you're ahead of the curve",
  below: ' — big upside waiting to be captured',
};
---

<BaseLayout
  title={paid ? 'Your AI Readiness Report — LeTrainAI' : 'Report — LeTrainAI'}
  description={paid
    ? 'Your full AI Readiness Report: ranked opportunities, 90-day roadmap, tool stack, and ROI projection.'
    : 'AI Readiness Report access page.'}
  noindex
>
  <main class="bg-canvas text-body">
    {!found && (
      <div class="px-6 py-24 sm:py-32 pt-32">
        <div class="mx-auto w-full max-w-2xl text-center">
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-muted mb-4">Report</p>
          <h1 class="font-serif text-3xl sm:text-4xl text-ink mb-4">Report not found</h1>
          <p class="text-muted mb-8">This report link is invalid or the assessment wasn't completed.</p>
          <a href="/assessment" class="inline-flex items-center gap-2 rounded-lg bg-accent px-6 py-3 font-sans text-sm font-medium text-white transition-colors hover:bg-accent-hover">
            Take the free assessment →
          </a>
        </div>
      </div>
    )}

    {found && !paid && (
      <div class="px-6 py-24 sm:py-32 pt-32">
        <div class="mx-auto w-full max-w-2xl">
          <div class="text-center mb-10">
            <p class="font-mono text-xs uppercase tracking-[0.2em] text-muted mb-4">Almost there</p>
            <h1 class="font-serif text-3xl sm:text-4xl text-ink mb-4">Your free results are ready</h1>
            <p class="text-muted">
              Below is your savings estimate and top opportunity. Unlock the full AI Readiness
              Report to see all ranked opportunities, the 90-day roadmap, tool stack, and ROI
              projection.
            </p>
            {Astro.url.searchParams.get('checkout') === 'cancelled' && (
              <p class="mt-4 font-mono text-xs text-muted">Checkout cancelled — you can resume any time below.</p>
            )}
          </div>

          <p class="text-center mb-6">
            <a href="/sample-report" data-cta="paywall-sample-link" class="font-sans text-sm text-accent underline underline-offset-4 hover:text-ink">
              Not sure what's inside? See a full sample report →
            </a>
          </p>

          {freeTeaser && (
            <div class="rounded-lg border border-hairline bg-surface p-6 sm:p-8 mb-8">
              <div class="flex items-baseline justify-between gap-4 mb-6">
                <p class="font-mono text-xs uppercase tracking-[0.2em] text-muted">Your free results</p>
                <p class="font-mono text-sm text-accent font-medium">{freeTeaser.opportunity_score}/100</p>
              </div>
              <p class="font-serif text-3xl sm:text-4xl text-ink leading-[1.05]">
                {freeTeaser.estimated_savings}
                <span class="block text-lg sm:text-xl text-body mt-2">in potential savings</span>
              </p>
              {bench && (
                <p class="mt-3 font-mono text-xs text-muted">
                  Typical for {bench.size}-person teams: {bench.typicalScore}/100{VERDICT_COPY[verdict ?? 'average'] ?? ''}
                </p>
              )}
              <div class="mt-6 rounded-lg border border-hairline bg-canvas p-5">
                <p class="font-serif text-lg text-ink mb-2">{freeTeaser.recommendations[0]?.title}</p>
                <p class="text-sm text-body leading-relaxed mb-3">{freeTeaser.recommendations[0]?.description}</p>
                <p class="font-mono text-xs text-muted">Saves {freeTeaser.recommendations[0]?.estimated_time_saved}</p>
              </div>
              {freeTeaser.locked_count > 0 && (
                <p class="mt-4 font-mono text-xs text-muted">
                  + {freeTeaser.locked_count} more opportunities in the full report
                </p>
              )}
            </div>
          )}

          <div class="space-y-4">
            <form method="POST" action="/api/checkout" class="rounded-lg border border-accent bg-surface p-6 sm:p-8">
              <input type="hidden" name="session_id" value={sessionId} />
              <input type="hidden" name="tier" value="report" />
              <div class="flex items-start justify-between gap-4 mb-4">
                <div>
                  <p class="font-serif text-xl text-ink">Full AI Readiness Report</p>
                  <p class="text-sm text-muted mt-1">All opportunities · 90-day roadmap · tool stack · ROI — delivered instantly.</p>
                </div>
                <p class="font-mono text-lg text-accent shrink-0">$149</p>
              </div>
              <button type="submit" class="w-full inline-flex items-center justify-center gap-2 rounded-lg bg-accent px-6 py-3.5 font-sans text-sm font-medium text-white transition-colors hover:bg-accent-hover">
                Unlock my report — $149 →
              </button>
            </form>

            <form method="POST" action="/api/checkout" class="rounded-lg border border-hairline bg-surface p-6 sm:p-8">
              <input type="hidden" name="session_id" value={sessionId} />
              <input type="hidden" name="tier" value="session" />
              <div class="flex items-start justify-between gap-4 mb-4">
                <div>
                  <p class="font-serif text-xl text-ink">Report + Strategy Session</p>
                  <p class="text-sm text-muted mt-1">Everything in the report plus a 60-minute implementation session with a LeTrain AI consultant.</p>
                </div>
                <p class="font-mono text-lg text-accent shrink-0">$499</p>
              </div>
              <button type="submit" class="w-full inline-flex items-center justify-center gap-2 rounded-lg border border-accent px-6 py-3.5 font-sans text-sm font-medium text-accent transition-colors hover:bg-canvas">
                Get report + session — $499 →
              </button>
            </form>
          </div>

          <p class="mt-6 text-center text-xs text-muted">
            Secure payment via Stripe · 14-day refund guarantee · <a href="/refunds" class="underline underline-offset-4 hover:text-ink">Refund policy</a>
          </p>
        </div>
      </div>
    )}

    {paid && result && (
      <article class="px-6 py-16 sm:py-24 pt-32 pb-24">
        <div class="mx-auto w-full max-w-3xl">
          <div class="border-b border-hairline pb-10 mb-10">
            <p class="font-mono text-xs uppercase tracking-[0.2em] text-muted mb-6">
              AI Readiness Report {isSessionTier && '· Strategy Session included'}
            </p>
            <h1 class="font-serif text-4xl sm:text-5xl text-ink leading-[1.05]">
              {result.estimated_savings}
              <span class="block text-xl sm:text-2xl text-body mt-3">in identified annual savings</span>
            </h1>
            <div class="mt-8">
              <div class="flex items-center justify-between mb-2">
                <p class="font-mono text-xs uppercase tracking-[0.2em] text-muted">Opportunity score</p>
                <p class="font-mono text-sm text-accent font-medium">{result.opportunity_score}/100</p>
              </div>
            <div class="h-2 w-full rounded-full bg-hairline overflow-hidden">
              <div class="h-full rounded-full bg-accent" style={`width: ${result.opportunity_score}%`}></div>
            </div>
            {bench && (
              <p class="mt-3 font-mono text-xs text-muted">
                Typical for {bench.size}-person teams: {bench.typicalScore}/100{VERDICT_COPY[verdict ?? 'average'] ?? ''}
              </p>
            )}
          </div>
            {isSessionTier && (
              <div class="mt-8 rounded-lg border border-accent bg-surface p-6">
                <p class="font-serif text-lg text-ink mb-2">Your strategy session is included</p>
                <p class="text-sm text-muted mb-4">Book your 60-minute implementation session — we'll walk through this report and build your action plan together.</p>
                <a href="/contact?subject=Strategy%20session%20booking" class="inline-flex items-center gap-2 rounded-lg bg-accent px-6 py-3 font-sans text-sm font-medium text-white transition-colors hover:bg-accent-hover">
                  Book my session →
                </a>
              </div>
            )}
            <div class="mt-8 flex flex-wrap items-center gap-3 print:hidden" data-report-session={sessionId}>
              <button id="print-report" type="button" class="inline-flex items-center gap-2 rounded-lg border border-hairline bg-canvas px-4 py-2 font-sans text-xs font-medium text-body transition-colors hover:border-muted">
                Save as PDF
              </button>
              <button id="copy-report-link" type="button" class="inline-flex items-center gap-2 rounded-lg border border-hairline bg-canvas px-4 py-2 font-sans text-xs font-medium text-body transition-colors hover:border-muted">
                Copy link
              </button>
            </div>
          </div>

          {result.report?.summary && (
            <section class="mb-10">
              <h2 class="font-mono text-xs uppercase tracking-[0.2em] text-muted mb-4">Executive summary</h2>
              <p class="text-body leading-relaxed">{result.report.summary}</p>
            </section>
          )}

          <ReportBody result={result} />

          <div class="mt-10 text-center">
            <a href="/contact" class="inline-flex items-center gap-2 rounded-lg bg-accent px-8 py-4 font-sans text-sm font-medium text-white transition-colors hover:bg-accent-hover">
              Talk to us about implementing this →
            </a>
            <p class="mt-6 text-sm text-muted print:hidden">
              Your business changes — re-take the assessment in 90 days to measure progress.
              <a href="/assessment" class="text-body underline underline-offset-4 hover:text-ink">Start again →</a>
            </p>
          </div>
        </div>
      </article>
    )}
  </main>

  <script>
    import { track } from '@/lib/analytics/client';

    const actions = document.querySelector<HTMLElement>('[data-report-session]');
    const sessionId = actions?.dataset.reportSession ?? '';

    document.getElementById('copy-report-link')?.addEventListener('click', async () => {
      const btn = document.getElementById('copy-report-link');
      const link = window.location.origin + window.location.pathname;
      try {
        await navigator.clipboard.writeText(link);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = link;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        ta.remove();
      }
      if (btn) btn.textContent = 'Link copied ✓';
      track('report_link_copy', sessionId ? { sessionId } : {});
      window.setTimeout(() => {
        if (btn) btn.textContent = 'Copy link';
      }, 2500);
    });

    document.getElementById('print-report')?.addEventListener('click', () => {
      track('report_share', sessionId ? { sessionId } : {});
      window.print();
    });
  </script>
</BaseLayout>
