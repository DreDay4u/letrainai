# LeTrainAI environment variables — names only, never commit real values.
# Runtime secrets enter via Coolify env_file; this file documents the contract.

# DeepSeek (assessment generator; absent key => deterministic fallback engine)
DEEPSEEK_API_KEY=

# Supabase (self-hosted; service role is server-side only, never expose)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public site origin (checkout success/cancel URL construction)
NEXT_PUBLIC_SITE_URL=
PUBLIC_SITE_URL=

# Stripe (paid report rail; absent keys => checkout 503s gracefully)
STRIPE_SECRET_KEY=
STRIPE_PRICE_REPORT=
STRIPE_PRICE_SESSION=
STRIPE_WEBHOOK_SECRET=

# SSR server
PORT=

# Keystatic admin: local-mode storage is UNAUTHENTICATED — set to 1 only to
# deliberately re-enable the /keystatic admin on a deployed server (writes
# are ephemeral on the container and never reach git). Leave unset in prod.
KEYSTATIC_ADMIN_ENABLED=
