.git
.gitignore
.vscode
.idea
.DS_Store

# Keep infra files out of the build context
Dockerfile
.dockerignore
docker-compose.yml
docker-compose.*.yml

# Logs and build info
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo
